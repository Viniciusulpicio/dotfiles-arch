[Desktop Entry]
Type=Application
Name=OpenWhip (Visual)
Comment=Whip overlay visual na barra superior do GNOME
Exec=sh -c "sleep 6 && if [ -x ~/openwhip-visual/node_modules/electron/dist/electron ]; then exec ~/openwhip-visual/node_modules/electron/dist/electron ~/openwhip-visual; elif command -v electron >/dev/null 2>&1 && [ -d ~/openwhip-visual ]; then exec electron ~/openwhip-visual; fi"
Icon=/home/vinicius/openwhip-visual/icon/tray-linux.png
Terminal=false
Categories=Utility;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=6
