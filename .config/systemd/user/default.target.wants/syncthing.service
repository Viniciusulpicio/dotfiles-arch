[Unit]
Description=Syncthing - Open Source Continuous File Synchronization
Documentation=man:syncthing(1)
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
ExecStart=/bin/sh -c 'if [ -x "%h/.local/bin/syncthing" ]; then exec "%h/.local/bin/syncthing" serve --no-browser --no-restart; else exec /usr/bin/syncthing serve --no-browser --no-restart; fi'
Restart=on-failure
RestartSec=1
SuccessExitStatus=3 4
RestartForceExitStatus=3 4

[Install]
WantedBy=default.target
