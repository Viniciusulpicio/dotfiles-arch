[Desktop Entry]
Type=Application
Name=OpenWhip (Chicote)
Comment=Whip overlay visual na barra superior do GNOME
Exec=sh -c "if [ -x ~/openwhip-visual/node_modules/electron/dist/electron ]; then exec ~/openwhip-visual/node_modules/electron/dist/electron ~/openwhip-visual; elif command -v electron >/dev/null 2>&1 && [ -d ~/openwhip-visual ]; then exec electron ~/openwhip-visual; fi"
Icon=/home/vinicius/openwhip-visual/icon/Template.png
Terminal=false
Categories=Utility;
Keywords=whip;chicote;openwhip;
StartupNotify=false
