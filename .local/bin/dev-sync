#!/usr/bin/env bash
#
# dev-sync: Sincronização rápida de ambiente de desenvolvimento via Rclone
#

set -e

# Configurações padrão (podem ser sobrescritas no ~/.zshrc via DEV_WORKSPACE ou DEV_REMOTE)
LOCAL_DIR="${DEV_WORKSPACE:-$HOME/temp}"
REMOTE_DIR="${DEV_REMOTE:-GoogleDrive:dev-workspace}"
FILTER_FILE="$HOME/.config/rclone/dev-filter.txt"

# Cores para saída amigável
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Detectar se foi chamado como dev-push ou dev-pull
CMD_NAME=$(basename "$0")
ACTION="$1"

if [[ "$CMD_NAME" == "dev-push" ]]; then
    ACTION="push"
elif [[ "$CMD_NAME" == "dev-pull" ]]; then
    ACTION="pull"
fi

notify() {
    local msg="$1"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Dev Sync" "$msg" --icon=sync-synchronizing 2>/dev/null || true
    fi
}

show_help() {
    echo -e "${BLUE}=== Dev Sync ===${NC}"
    echo "Uso:"
    echo "  dev-push         Envia seus arquivos para a nuvem (ao sair)"
    echo "  dev-pull         Baixa os arquivos da nuvem para o PC (ao começar)"
    echo "  dev-sync status  Compara arquivos locais com a nuvem"
    echo ""
    echo "Configuração atual:"
    echo "  Local:  $LOCAL_DIR"
    echo "  Remoto: $REMOTE_DIR"
    echo "  Filtro: $FILTER_FILE"
}

check_dependencies() {
    if ! command -v rclone >/dev/null 2>&1; then
        echo -e "${RED}[ERRO] rclone não está instalado.${NC}"
        exit 1
    fi
    if [[ ! -f "$FILTER_FILE" ]]; then
        echo -e "${RED}[ERRO] Arquivo de filtro não encontrado: $FILTER_FILE${NC}"
        exit 1
    fi
}

repair_git_dirs() {
    # Garante que todas as pastas .git tenham a estrutura obrigatória (refs/heads, refs/tags, objects/info, objects/pack)
    # pois o Google Drive / rclone pode omitir pastas vazias após git gc / pack-refs, fazendo o git achar que não é um repo.
    if [[ -d "$LOCAL_DIR" ]]; then
        while IFS= read -r -d '' gitdir; do
            mkdir -p "$gitdir/refs/heads" "$gitdir/refs/tags" "$gitdir/objects/info" "$gitdir/objects/pack"
        done < <(find "$LOCAL_DIR" -type d -name ".git" -print0 2>/dev/null)
    fi
}

sync_leis_repo() {
    mkdir -p "$LOCAL_DIR"
    if [[ ! -d "$LOCAL_DIR/leis/.git" ]]; then
        echo -e "\n${BLUE}==> Clonando repositório 'leis' via Git...${NC}"
        git clone https://github.com/ctresb/leis.git "$LOCAL_DIR/leis" || true
    else
        echo -e "\n${BLUE}==> Atualizando repositório 'leis' via Git...${NC}"
        git -C "$LOCAL_DIR/leis" pull --ff-only || true
    fi
}

do_push() {
    check_dependencies
    repair_git_dirs
    echo -e "${BLUE}==> [PUSH] Enviando arquivos locais para o Google Drive...${NC}"
    echo -e "Origem:  ${YELLOW}$LOCAL_DIR${NC}"
    echo -e "Destino: ${YELLOW}$REMOTE_DIR${NC}\n"

    rclone sync "$LOCAL_DIR" "$REMOTE_DIR" \
        --filter-from "$FILTER_FILE" \
        --create-empty-src-dirs \
        --fast-list \
        --transfers 8 \
        --progress

    sync_leis_repo

    echo -e "\n${GREEN}✔ Sincronização concluída com sucesso! [$(date +'%H:%M:%S')]${NC}"
    notify "Projetos enviados para o Google Drive com sucesso!"
}

do_pull() {
    check_dependencies
    echo -e "${BLUE}==> [PULL] Baixando arquivos do Google Drive para o computador...${NC}"
    echo -e "Origem:  ${YELLOW}$REMOTE_DIR${NC}"
    echo -e "Destino: ${YELLOW}$LOCAL_DIR${NC}\n"

    # Verificar se a pasta já existe no Google Drive
    if ! rclone lsf "$REMOTE_DIR" --max-depth 1 >/dev/null 2>&1; then
        echo -e "${RED}[AVISO] A pasta remota '$REMOTE_DIR' ainda não existe no Google Drive.${NC}"
        echo -e "${YELLOW}Isso acontece porque o primeiro 'dev-push' ainda não foi executado.${NC}"
        echo -e "Execute primeiro: ${GREEN}dev-push${NC} no PC onde estão seus projetos para criá-la na nuvem.\n"
        exit 1
    fi

    mkdir -p "$LOCAL_DIR"
    rclone sync "$REMOTE_DIR" "$LOCAL_DIR" \
        --filter-from "$FILTER_FILE" \
        --create-empty-src-dirs \
        --fast-list \
        --transfers 8 \
        --progress

    repair_git_dirs
    sync_leis_repo

    echo -e "\n${GREEN}✔ Projetos atualizados com sucesso! [$(date +'%H:%M:%S')]${NC}"
    notify "Projetos atualizados a partir do Google Drive!"
}

do_status() {
    check_dependencies
    echo -e "${BLUE}==> Verificando diferenças entre local e Google Drive...${NC}\n"
    rclone check "$LOCAL_DIR" "$REMOTE_DIR" \
        --filter-from "$FILTER_FILE" \
        --one-way || true
}

case "$ACTION" in
    push)
        do_push
        ;;
    pull)
        do_pull
        ;;
    status)
        do_status
        ;;
    *)
        show_help
        ;;
esac
