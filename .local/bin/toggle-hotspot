#!/usr/bin/env bash

# Verifica se o Hotspot está ativo
if nmcli connection show --active | grep -q "Hotspot"; then
    nmcli connection down Hotspot
    nmcli connection up Unimar 2>/dev/null || true
    notify-send -i network-wireless "Hotspot Wi-Fi" "Roteador Desligado. Reconectado ao Wi-Fi."
else
    # Garante encaminhamento de IP
    sudo -n sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    nmcli connection up Hotspot
    notify-send -i network-wireless-hotspot "Hotspot Wi-Fi" "Roteador Ativado!\nSSID: thinkpad\nSenha: 31070713"
fi
